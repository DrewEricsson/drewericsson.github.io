---
// A comic-book sound effect that pops up wherever the page is clicked, then
// breaks up into halftone dots.
---

<script>
  const words = ['POW!', 'BOOM!', 'OUCH!', 'BAM!', 'ZAP!', 'WHAM!', 'BIFF!', 'KAPOW!', 'THWACK!', 'ZOK!'];
  let last = '';

  document.addEventListener('click', (event) => {
    if (event.detail === 0) return;
    const target = event.target as Element | null;
    // Not on links, buttons or form fields, and not when text has just been selected.
    if (
      target?.closest(
        'a, button, input, textarea, select, label, summary, [role="button"], [contenteditable], [tabindex]'
      )
    ) {
      return;
    }
    const selection = window.getSelection();
    if (selection && !selection.isCollapsed) return;
    if (document.querySelectorAll('.pow').length > 6) return;

    let word = last;
    while (word === last) word = words[Math.floor(Math.random() * words.length)];
    last = word;

    const pow = document.createElement('span');
    pow.className = 'pow';
    pow.setAttribute('aria-hidden', 'true');
    pow.style.left = `${event.clientX}px`;
    pow.style.top = `${event.clientY}px`;
    pow.style.setProperty('--pow-len', String(word.length));
    pow.style.setProperty('--pow-rot', `${Math.round(Math.random() * 30 - 15)}deg`);
    pow.innerHTML = `<span class="pow__burst"></span><span class="pow__word">${word}</span>`;
    pow.addEventListener('animationend', () => pow.remove());
    document.body.append(pow);
  });
</script>

<style is:global>
  @property --pow-dot {
    syntax: '<length>';
    inherits: false;
    initial-value: 8px;
  }

  .pow {
    position: fixed;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 10.5rem;
    height: 8rem;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(var(--pow-rot, 0deg));
    filter: drop-shadow(2px 0 0 var(--print-black)) drop-shadow(-2px 0 0 var(--print-black))
      drop-shadow(0 2px 0 var(--print-black)) drop-shadow(0 -2px 0 var(--print-black))
      drop-shadow(5px 5px 0 var(--print-cyan));
    /* Halftone dissolve: a grid of dots that starts solid and shrinks to nothing. */
    -webkit-mask-image: radial-gradient(circle, #000 var(--pow-dot), transparent calc(var(--pow-dot) + 0.6px));
    mask-image: radial-gradient(circle, #000 var(--pow-dot), transparent calc(var(--pow-dot) + 0.6px));
    -webkit-mask-size: 9px 9px;
    mask-size: 9px 9px;
    -webkit-mask-position: center;
    mask-position: center;
    animation: pow 760ms cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  .pow > * {
    grid-area: 1 / 1;
  }

  .pow__burst {
    width: 100%;
    height: 100%;
    background-color: var(--print-yellow);
    background-image: radial-gradient(circle, var(--print-magenta) 1px, transparent 1.5px);
    background-size: 6px 6px;
    clip-path: polygon(50.0% 1.6%, 57.5% 19.6%, 73.4% 5.4%, 70.5% 26.8%, 90.9% 21.8%, 80.0% 38.6%, 96.5% 44.4%, 82.5% 53.9%, 93.7% 66.6%, 76.7% 68.4%, 81.1% 85.1%, 64.4% 77.5%, 61.7% 97.6%, 50.0% 84.0%, 38.7% 95.9%, 35.3% 78.0%, 16.7% 87.6%, 21.7% 69.6%, 3.3% 67.7%, 18.0% 53.9%, -2.0% 43.7%, 21.1% 39.1%, 7.5% 20.7%, 28.9% 26.2%, 28.0% 8.1%, 42.5% 19.7%);
  }

  .pow__word {
    font-family: Impact, 'Arial Black', 'Helvetica Neue', sans-serif;
    font-size: calc(2.4rem * min(1, 5 / var(--pow-len, 5)));
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--print-magenta);
    transform: skew(-6deg);
  }

  @keyframes pow {
    0% {
      transform: translate(-50%, -50%) rotate(var(--pow-rot, 0deg)) scale(0.2);
      --pow-dot: 8px;
    }
    11% {
      transform: translate(-50%, -50%) rotate(var(--pow-rot, 0deg)) scale(1.18);
    }
    19% {
      transform: translate(-50%, -50%) rotate(var(--pow-rot, 0deg)) scale(1);
      --pow-dot: 8px;
    }
    100% {
      transform: translate(-50%, -50%) rotate(var(--pow-rot, 0deg)) scale(1.06);
      --pow-dot: 0px;
    }
  }

  /* With reduced motion: no pop or zoom, it just appears and dots away. */
  @keyframes pow-still {
    0%,
    19% {
      --pow-dot: 8px;
    }
    100% {
      --pow-dot: 0px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pow {
      animation: pow-still 760ms ease-in forwards !important;
      animation-duration: 760ms !important;
    }
  }
</style>
