---
import { stripBase, withBase } from '../lib/url';

const navItems = [
  { label: 'Blog', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = stripBase(Astro.url.pathname);

function currentState(href: string): 'page' | 'true' | undefined {
  if (currentPath === href || currentPath === href.slice(0, -1)) return 'page';
  if (currentPath.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="site-header band">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={withBase('/')}>
      <span class="site-header__name">WriteCraft</span>
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={currentState(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="site-header__theme" type="button" aria-label="Dark theme" aria-pressed="false">
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
        <path
          d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          fill="none"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.site-header__theme');
  const root = document.documentElement;

  function sync() {
    button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }
  sync();

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
    sync();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-block: var(--space-s);
    box-shadow: var(--shadow-soft);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: inherit;
    text-decoration: none;
  }

  .site-header__name {
    font-size: 1.1875rem;
    font-weight: var(--weight-heading);
    line-height: 1;
    transition: color 0.15s ease;
  }

  .site-header__brand:hover .site-header__name {
    color: var(--color-band-accent);
  }

  .site-header__brand {
    order: 1;
    margin-right: auto;
  }

  .site-header__theme {
    order: 2;
  }

  .site-header__nav {
    order: 3;
    flex-basis: 100%;
  }

  @media (min-width: 46em) {
    .site-header__nav {
      order: 2;
      flex-basis: auto;
    }

    .site-header__theme {
      order: 3;
    }
  }

  .site-header__theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    color: var(--color-band-muted);
    border: 1px solid var(--color-band-rule);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .site-header__theme:hover {
    color: var(--color-band-accent);
    border-color: var(--color-band-accent);
  }

  .site-header__theme .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .site-header__theme .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .site-header__theme .icon-sun {
    display: block;
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 46em) {
    .site-header__nav ul {
      gap: var(--space-l);
    }
  }

  .site-header__nav a {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-band-muted);
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.55em;
  }

  .site-header__nav a:hover {
    color: var(--color-band-text);
    text-decoration-color: var(--color-band-accent);
  }

  .site-header__nav a[aria-current] {
    color: var(--color-band-text);
    text-decoration-color: var(--color-band-accent);
  }
</style>
