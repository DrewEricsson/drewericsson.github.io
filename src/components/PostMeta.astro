---
import { formatDate, formatNumber, readingTime } from '../lib/posts';

interface Props {
  date: Date;
  words: number;
  class?: string;
}

const { date, words, class: className } = Astro.props;
---

<p class:list={['meta-text', 'post-meta', className]}>
  <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  <span aria-hidden="true">·</span>
  <span>{formatNumber(words)} words</span>
  <span aria-hidden="true">·</span>
  <span>{readingTime(words)} min read</span>
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
  }

  .post-meta > * {
    white-space: nowrap;
  }
</style>
